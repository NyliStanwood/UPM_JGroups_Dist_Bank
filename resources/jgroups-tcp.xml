<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="urn:org:jgroups"
  xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd">

  <!-- TCP Transport Layer -->
  <TCP
    bind_addr="${jgroups.tcp.bind_addr:localhost}"
    bind_port="${jgroups.tcp.bind_port:7800}"
    recv_buf_size="130000"
    send_buf_size="130000"
    thread_naming_pattern="pl"
    thread_pool.min_threads="0"
    thread_pool.max_threads="200"
    thread_pool.keep_alive_time="30000"
  />

  <!-- Initial members for bootstrap (required with TCP) -->
  <TCPGOSSIP
    initial_hosts="${jgroups.tcpgossip.initial_hosts:localhost[12345]}"
    timeout="3000"
    num_initial_members="3"
  />

  <!-- Socket-based failure detection (optimized for fast detection) -->
  <FD_SOCK 
    bind_addr="${jgroups.bind_addr:127.0.0.1}"
    start_port="9000"
    port_range="100"
    suspect_msg_interval="2000"
  />

  <!-- Heartbeat-based failure detection (backup) -->
  <FD_ALL 
    timeout="3000" 
    interval="1000" 
    timeout_check_interval="1000"
  />

  <!-- Verify suspected failures -->
  <VERIFY_SUSPECT timeout="1500" />

  <!-- Synchronization barrier -->
  <BARRIER />

  <!-- Group membership service (optimized for fault tolerance) -->
  <pbcast.GMS
    print_local_addr="true"
    join_timeout="3000"
    leave_timeout="1000"
    view_bundling="true"
    max_bundling_time="300"
    resume_task_timeout="7000"
    log_view_warnings="false"
  />

  <!-- Reliable multicast with FIFO and causal ordering -->
  <pbcast.NAKACK2
    use_mcast_xmit="false"
    retransmit_timeout="100,200,300,600"
    max_retransmit_time="30000"
    exponential_backoff="true"
    discard_delivered_msgs="true"
  />

  <!-- Reliable unicast -->
  <UNICAST3
    xmit_interval="100,200,300,600"
    max_retransmit_time="30000"
    conn_expiry_timeout="60000"
  />

  <!-- State transfer support -->
  <pbcast.STATE_TRANSFER />

</config>
