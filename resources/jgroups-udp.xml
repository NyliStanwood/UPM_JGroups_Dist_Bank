<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="urn:org:jgroups"
  xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd"
  version="5.0.0">

  <!-- UDP Transport Layer -->
  <UDP
    mcast_addr="${jgroups.udp.mcast_addr:228.0.0.4}"
    mcast_port="${jgroups.udp.mcast_port:45688}"
    ucast_recv_buf_size="130000"
    ucast_send_buf_size="130000"
    mcast_recv_buf_size="130000"
    mcast_send_buf_size="130000"
    thread_naming_pattern="pl"
    thread_pool.min_threads="0"
    thread_pool.max_threads="200"
    thread_pool.keep_alive_time="30000"
  />

  <!-- Discovery protocol for initial membership -->
  <PING />

  <!-- Socket-based failure detection (optimized for fast detection) -->
  <FD_SOCK 
    bind_addr="${jgroups.bind_addr:127.0.0.1}"
    start_port="9000"
    port_range="100"
    suspect_msg_interval="2000"
  />

  <!-- Heartbeat-based failure detection (backup) -->
  <FD_ALL 
    timeout="3000" 
    interval="1000" 
    timeout_check_interval="1000"
  />

  <!-- Verify suspected failures -->
  <VERIFY_SUSPECT timeout="1500" />

  <!-- Synchronization barrier -->
  <BARRIER />

  <!-- Reliable multicast with FIFO and causal ordering -->
  <pbcast.NAKACK2
    use_mcast_xmit="true"
    discard_delivered_msgs="true"
  />

  <!-- Reliable unicast -->
  <UNICAST3
    conn_expiry_timeout="60000"
  />

  <!-- Stable protocol for garbage collection of messages -->
  <pbcast.STABLE />

  <!-- Group membership service (optimized for fault tolerance) -->
  <pbcast.GMS
    print_local_addr="true"
    join_timeout="3000"
    leave_timeout="1000"
    log_view_warnings="false"
  />

  <!-- State transfer support -->
  <pbcast.STATE_TRANSFER />

</config>
