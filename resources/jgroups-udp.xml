<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="urn:org:jgroups"
  xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups-5.3.xsd">

  <!-- UDP Transport Layer -->
  <UDP
    mcast_addr="${jgroups.udp.mcast_addr:228.0.0.4}"
    mcast_port="${jgroups.udp.mcast_port:45688}"
    ucast_recv_buf_size="130000"
    ucast_send_buf_size="130000"
    mcast_recv_buf_size="130000"
    mcast_send_buf_size="130000"
    loopback="false"
    thread_naming_pattern="pl"
    thread_pool.min_threads="0"
    thread_pool.max_threads="200"
    thread_pool.keep_alive_time="30000"
    internal_thread_pool.enabled="true"
    internal_thread_pool.min_threads="1"
    internal_thread_pool.max_threads="4"
    internal_thread_pool.keep_alive_time="60000"
  />

  <!-- Gossip-based discovery for initial membership -->
  <PING timeout="2000" num_initial_members="3" />

  <!-- Socket-based failure detection -->
  <FD_SOCK />

  <!-- Verify suspected failures -->
  <VERIFY_SUSPECT timeout="1500" />

  <!-- Synchronization barrier -->
  <BARRIER />

  <!-- Group membership service -->
  <GMS
    print_local_addr="true"
    join_timeout="5000"
    leave_timeout="5000"
    view_bundling="true"
    max_bundling_time="500"
    resume_task_timeout="15000"
  />

  <!-- Ordered delivery before view changes -->
  <FLUSH />

  <!-- Reliable multicast with FIFO and causal ordering -->
  <NAKACK2
    use_mcast_xmit="true"
    retransmit_timeout="100,200,300,600"
    max_retransmit_time="30000"
    exponential_backoff="true"
    discard_delivered_msgs="true"
    resend_last_seqno="true"
  />

  <!-- Reliable unicast -->
  <UNICAST3
    xmit_interval="100,200,300,600"
    max_retransmit_time="30000"
    conn_expiry_timeout="60000"
  />

  <!-- State transfer support -->
  <STATE />

</config>
